# Every setting the app reads from its environment, with its local default.
# Locally you do not need to set any of them: the defaults match `make dev`.
# In staging and production, values come from the service's environment and
# secrets come from Secret Manager. Never commit real values.

# Where the database is (SQLAlchemy format, psycopg driver).
# Inside Docker Compose, docker-compose.yml overrides this to point at the `db` container.
DATABASE_URL=postgresql+psycopg://pm_system:pm_system@localhost:5432/pm_system

# The git commit the running image was built from. The Docker build sets it.
# GIT_COMMIT=dev
